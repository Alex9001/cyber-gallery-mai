<?xml version="1.0"?>
<ruleset
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	name="Cyber Gallery for Mai Theme WordPress standards"
	xsi:noNamespaceSchemaLocation="https://schema.phpcodesniffer.com/phpcs.xsd"
>
	<description>Enforce the complete WordPress coding standard for production PHP.</description>

	<file>cyber-gallery-mai.php</file>
	<file>blocks</file>
	<file>classes</file>
	<file>includes</file>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="cache" value=".phpcs-cache"/>
	<arg value="ps"/>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<config name="minimum_wp_version" value="7.1"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cyber-gallery-mai"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="cyber_gallery_mai"/>
				<element value="mai_cyber_gallery"/>
				<element value="mai_get_cyber_gallery"/>
				<element value="mai_do_cyber_gallery"/>
			</property>
		</properties>
	</rule>
</ruleset>
